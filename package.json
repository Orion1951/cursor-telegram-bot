{
  "name": "cursor-telegram-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development PINO_PRETTY=1 tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "grammy": "^1.37.4",
    "pino": "^9.13.4",
    "yaml": "^2.8.0",
    "zod": "^3.25.32"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.17.15",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.3",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.53.7",
    "vitest": "^4.1.6"
  }
}
